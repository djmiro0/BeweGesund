CONTENTFUL_SPACE_ID=your_contentful_space_id
CONTENTFUL_DELIVERY_TOKEN=your_contentful_delivery_token
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_LOCALE_DE=de
CONTENTFUL_LOCALE_EN=en-US
CONTENTFUL_CALENDAR_CONTENT_TYPE=calendarEvent
CONTENTFUL_VIDEO_CONTENT_TYPE=trainingVideo
CONTENTFUL_BLOG_CONTENT_TYPE=blogPost
CONTENTFUL_COURSE_CONTENT_TYPE=course

MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_ADMIN_UPLOAD_TOKEN=your_internal_upload_bearer_token
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
MUX_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

FIREBASE_PROJECT_ID=sandrin-app
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sandrin-app.firebasestorage.app

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe billing is configured for Firebase Functions in functions/.env.<project-id>
# and Firebase Secret Manager. See docs/stripe-billing.md.

LEGAL_PROVIDER_NAME=your_legal_business_or_person_name
LEGAL_PROVIDER_ADDRESS=street, postal_code city, country
LEGAL_PROVIDER_EMAIL=info@bewegesund.de
LEGAL_PROVIDER_PHONE=your_business_phone
LEGAL_RESPONSIBLE_PERSON=responsible_person_name
LEGAL_VAT_ID=optional_vat_id
