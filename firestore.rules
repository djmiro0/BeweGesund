rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidAge(value) {
      return value is number && value >= 1 && value <= 120;
    }

    function isValidGender(value) {
      return value in ["female", "male"];
    }

    function hasValidHealthProfile() {
      return (!request.resource.data.keys().hasAny(["age"]) || isValidAge(request.resource.data.age))
        && (!request.resource.data.keys().hasAny(["gender"]) || isValidGender(request.resource.data.gender))
        && (!request.resource.data.keys().hasAny(["heightCm"]) || request.resource.data.heightCm == null
          || (request.resource.data.heightCm is number
            && request.resource.data.heightCm >= 80
            && request.resource.data.heightCm <= 240))
        && (!request.resource.data.keys().hasAny(["weightKg"]) || request.resource.data.weightKg == null
          || (request.resource.data.weightKg is number
            && request.resource.data.weightKg >= 25
            && request.resource.data.weightKg <= 300));
    }

    function hasValidAnamnesis() {
      return request.resource.data.keys().hasAny(["anamnesis"])
        && request.resource.data.anamnesis is map
        && request.resource.data.anamnesis.keys().hasOnly([
          "age",
          "goals",
          "complaints",
          "fitnessLevel",
          "movementRestrictions",
          "stressLevel",
          "sleepDisturbance",
          "contraindications",
          "legalConfirmed",
          "completedAt"
        ])
        && isValidAge(request.resource.data.anamnesis.age)
        && request.resource.data.anamnesis.goals is list
        && request.resource.data.anamnesis.goals.size() > 0
        && request.resource.data.anamnesis.complaints is list
        && request.resource.data.anamnesis.complaints.size() > 0
        && request.resource.data.anamnesis.fitnessLevel is string
        && request.resource.data.anamnesis.movementRestrictions is list
        && request.resource.data.anamnesis.movementRestrictions.size() > 0
        && request.resource.data.anamnesis.stressLevel is string
        && request.resource.data.anamnesis.sleepDisturbance is string
        && request.resource.data.anamnesis.contraindications is list
        && request.resource.data.anamnesis.contraindications.size() > 0
        && request.resource.data.anamnesis.legalConfirmed == true
        && request.resource.data.anamnesis.completedAt is timestamp;
    }

    function isValidRegion(value) {
      return value in [
        "baden-wuerttemberg",
        "bavaria",
        "berlin",
        "brandenburg",
        "bremen",
        "hamburg",
        "hesse",
        "lower-saxony",
        "mecklenburg-western-pomerania",
        "north-rhine-westphalia",
        "rhineland-palatinate",
        "saarland",
        "saxony",
        "saxony-anhalt",
        "schleswig-holstein",
        "thuringia"
      ];
    }

    function profileImmutableFieldsUnchanged() {
      return request.resource.data.xp == resource.data.xp
        && request.resource.data.points == resource.data.points
        && request.resource.data.premiumStatus == resource.data.premiumStatus
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.memberPackage == resource.data.memberPackage
        && request.resource.data.currentStreak == resource.data.currentStreak
        && request.resource.data.longestStreak == resource.data.longestStreak
        && request.resource.data.weeklyLeaderboardRank == resource.data.weeklyLeaderboardRank
        && request.resource.data.monthlyLeaderboardRank == resource.data.monthlyLeaderboardRank
        && request.resource.data.weeklyScore == resource.data.weeklyScore
        && request.resource.data.monthlyScore == resource.data.monthlyScore
        && request.resource.data.claimedRewardIds == resource.data.claimedRewardIds
        && request.resource.data.startedCourseIds == resource.data.startedCourseIds
        && request.resource.data.completedCourseIds == resource.data.completedCourseIds
        && request.resource.data.recommendedCourseIds == resource.data.recommendedCourseIds
        && request.resource.data.anamnesis == resource.data.anamnesis
        && request.resource.data.anamnesisStatusKey == resource.data.anamnesisStatusKey
        && request.resource.data.consentAcceptedAt == resource.data.consentAcceptedAt
        && request.resource.data.keys().hasAny(["healthConsentAcceptedAt"])
          == resource.data.keys().hasAny(["healthConsentAcceptedAt"])
        && (!resource.data.keys().hasAny(["healthConsentAcceptedAt"])
          || request.resource.data.healthConsentAcceptedAt == resource.data.healthConsentAcceptedAt)
        && request.resource.data.keys().hasAny(["stripeCustomerId"])
          == resource.data.keys().hasAny(["stripeCustomerId"])
        && (!resource.data.keys().hasAny(["stripeCustomerId"])
          || request.resource.data.stripeCustomerId == resource.data.stripeCustomerId)
        && request.resource.data.keys().hasAny(["stripeSubscriptionId"])
          == resource.data.keys().hasAny(["stripeSubscriptionId"])
        && (!resource.data.keys().hasAny(["stripeSubscriptionId"])
          || request.resource.data.stripeSubscriptionId == resource.data.stripeSubscriptionId)
        && request.resource.data.keys().hasAny(["stripeSubscriptionStatus"])
          == resource.data.keys().hasAny(["stripeSubscriptionStatus"])
        && (!resource.data.keys().hasAny(["stripeSubscriptionStatus"])
          || request.resource.data.stripeSubscriptionStatus == resource.data.stripeSubscriptionStatus)
        && request.resource.data.roles == resource.data.roles;
    }

    function hasOnlyProfileFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "firstName",
        "lastName",
        "displayName",
        "photoURL",
        "age",
        "gender",
        "dateOfBirth",
        "heightCm",
        "weightKg",
        "occupationKey",
        "regionKey",
        "averageStepsPerDay",
        "primaryGoalKey",
        "memberPackage",
        "startedCourseIds",
        "completedCourseIds",
        "recommendedCourseIds",
        "anamnesis",
        "anamnesisStatusKey",
        "consentAcceptedAt",
        "healthConsentAcceptedAt",
        "createdAt",
        "updatedAt",
        "xp",
        "points",
        "premiumStatus",
        "subscriptionStatus",
        "currentStreak",
        "longestStreak",
        "weeklyScore",
        "monthlyScore",
        "weeklyLeaderboardRank",
        "monthlyLeaderboardRank",
        "claimedRewardIds",
        "roles"
      ]);
    }

    function isValidProfileCreate(userId) {
      return isOwner(userId)
        && hasOnlyProfileFields()
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && hasValidHealthProfile()
        && isValidRegion(request.resource.data.regionKey)
        && request.resource.data.memberPackage in ["basic", "plus"]
        && request.resource.data.startedCourseIds == []
        && request.resource.data.completedCourseIds == []
        && request.resource.data.recommendedCourseIds == []
        && hasValidAnamnesis()
        && request.resource.data.anamnesisStatusKey in ["completed", "review-required"]
        && request.resource.data.consentAcceptedAt is timestamp
        && request.resource.data.healthConsentAcceptedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.xp == 0
        && request.resource.data.points == 0
        && request.resource.data.premiumStatus == "free"
        && request.resource.data.subscriptionStatus == "free"
        && request.resource.data.currentStreak == 0
        && request.resource.data.longestStreak == 0
        && request.resource.data.weeklyScore == 0
        && request.resource.data.monthlyScore == 0
        && request.resource.data.weeklyLeaderboardRank == null
        && request.resource.data.monthlyLeaderboardRank == null
        && request.resource.data.claimedRewardIds == []
        && request.resource.data.roles == ["member"];
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isValidProfileCreate(userId);
      allow update: if isOwner(userId)
        && profileImmutableFieldsUnchanged()
        && hasValidHealthProfile()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;

      match /lessonCompletions/{completionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /workoutCompletions/{completionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /rewards/{rewardId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /settings/{settingsId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "profile",
            "bodyProgress",
            "workoutPreferences",
            "nutrition",
            "notifications",
            "progressPhotos",
            "privacy",
            "app",
            "updatedAt"
          ]);
      }
    }

    match /leaderboards/{period} {
      allow read: if isSignedIn();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if false;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /research/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
