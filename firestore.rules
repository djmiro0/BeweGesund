rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidAge(value) {
      return value is number && value >= 1 && value <= 120;
    }

    function isValidGender(value) {
      return value in ["female", "male"];
    }

    function hasValidHealthProfile() {
      return (!request.resource.data.keys().hasAny(["age"]) || isValidAge(request.resource.data.age))
        && (!request.resource.data.keys().hasAny(["gender"]) || isValidGender(request.resource.data.gender))
        && (!request.resource.data.keys().hasAny(["heightCm"]) || request.resource.data.heightCm == null
          || (request.resource.data.heightCm is number
            && request.resource.data.heightCm >= 80
            && request.resource.data.heightCm <= 240))
        && (!request.resource.data.keys().hasAny(["weightKg"]) || request.resource.data.weightKg == null
          || (request.resource.data.weightKg is number
            && request.resource.data.weightKg >= 25
            && request.resource.data.weightKg <= 300));
    }

    function fieldChanged(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function hasValidChangedHealthProfile() {
      return (!fieldChanged("age") || isValidAge(request.resource.data.age))
        && (!fieldChanged("gender") || isValidGender(request.resource.data.gender))
        && (!fieldChanged("heightCm") || request.resource.data.heightCm == null
          || (request.resource.data.heightCm is number
            && request.resource.data.heightCm >= 80
            && request.resource.data.heightCm <= 240))
        && (!fieldChanged("weightKg") || request.resource.data.weightKg == null
          || (request.resource.data.weightKg is number
            && request.resource.data.weightKg >= 25
            && request.resource.data.weightKg <= 300));
    }

    function hasValidAnamnesis() {
      return request.resource.data.keys().hasAny(["anamnesis"])
        && request.resource.data.anamnesis is map
        && request.resource.data.anamnesis.keys().hasOnly([
          "age",
          "goals",
          "complaints",
          "fitnessLevel",
          "movementRestrictions",
          "stressLevel",
          "sleepDisturbance",
          "contraindications",
          "legalConfirmed",
          "completedAt"
        ])
        && isValidAge(request.resource.data.anamnesis.age)
        && request.resource.data.anamnesis.goals is list
        && request.resource.data.anamnesis.goals.size() > 0
        && request.resource.data.anamnesis.complaints is list
        && request.resource.data.anamnesis.complaints.size() > 0
        && request.resource.data.anamnesis.fitnessLevel is string
        && request.resource.data.anamnesis.movementRestrictions is list
        && request.resource.data.anamnesis.movementRestrictions.size() > 0
        && request.resource.data.anamnesis.stressLevel is string
        && request.resource.data.anamnesis.sleepDisturbance is string
        && request.resource.data.anamnesis.contraindications is list
        && request.resource.data.anamnesis.contraindications.size() > 0
        && request.resource.data.anamnesis.legalConfirmed == true
        && request.resource.data.anamnesis.completedAt is timestamp;
    }

    function isValidRegion(value) {
      return value in [
        "baden-wuerttemberg",
        "bavaria",
        "berlin",
        "brandenburg",
        "bremen",
        "hamburg",
        "hesse",
        "lower-saxony",
        "mecklenburg-western-pomerania",
        "north-rhine-westphalia",
        "rhineland-palatinate",
        "saarland",
        "saxony",
        "saxony-anhalt",
        "schleswig-holstein",
        "thuringia"
      ];
    }

    function profileOnlyMutableFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "firstName",
        "lastName",
        "displayName",
        "photoURL",
        "age",
        "dateOfBirth",
        "heightCm",
        "weightKg",
        "occupationKey",
        "regionKey",
        "averageStepsPerDay",
        "primaryGoalKey",
        "updatedAt"
      ]);
    }

    function hasOnlySettingsFields() {
      return request.resource.data.keys().hasOnly([
        "profile",
        "bodyProgress",
        "workoutPreferences",
        "nutrition",
        "notifications",
        "progressPhotos",
        "privacy",
        "app",
        "updatedAt"
      ]);
    }

    function settingsOnlyMutableFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "profile",
        "bodyProgress",
        "workoutPreferences",
        "nutrition",
        "notifications",
        "progressPhotos",
        "privacy",
        "app",
        "updatedAt"
      ]);
    }

    function hasOnlyProfileFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "firstName",
        "lastName",
        "displayName",
        "photoURL",
        "age",
        "gender",
        "dateOfBirth",
        "heightCm",
        "weightKg",
        "occupationKey",
        "regionKey",
        "averageStepsPerDay",
        "primaryGoalKey",
        "memberPackage",
        "startedCourseIds",
        "completedCourseIds",
        "recommendedCourseIds",
        "anamnesis",
        "anamnesisStatusKey",
        "consentAcceptedAt",
        "healthConsentAcceptedAt",
        "createdAt",
        "updatedAt",
        "xp",
        "points",
        "premiumStatus",
        "subscriptionStatus",
        "currentStreak",
        "longestStreak",
        "weeklyScore",
        "monthlyScore",
        "weeklyLeaderboardRank",
        "monthlyLeaderboardRank",
        "claimedRewardIds",
        "roles"
      ]);
    }

    function isValidProfileCreate(userId) {
      return isOwner(userId)
        && hasOnlyProfileFields()
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && hasValidHealthProfile()
        && isValidRegion(request.resource.data.regionKey)
        && request.resource.data.memberPackage in ["basic", "plus"]
        && request.resource.data.startedCourseIds == []
        && request.resource.data.completedCourseIds == []
        && request.resource.data.recommendedCourseIds == []
        && hasValidAnamnesis()
        && request.resource.data.anamnesisStatusKey in ["completed", "review-required"]
        && request.resource.data.consentAcceptedAt is timestamp
        && request.resource.data.healthConsentAcceptedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.xp == 0
        && request.resource.data.points == 0
        && request.resource.data.premiumStatus == "free"
        && request.resource.data.subscriptionStatus == "free"
        && request.resource.data.currentStreak == 0
        && request.resource.data.longestStreak == 0
        && request.resource.data.weeklyScore == 0
        && request.resource.data.monthlyScore == 0
        && request.resource.data.weeklyLeaderboardRank == null
        && request.resource.data.monthlyLeaderboardRank == null
        && request.resource.data.claimedRewardIds == []
        && request.resource.data.roles == ["member"];
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isValidProfileCreate(userId);
      allow update: if isOwner(userId)
        && profileOnlyMutableFieldsChanged()
        && hasValidChangedHealthProfile();
      allow delete: if false;

      match /lessonCompletions/{completionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /workoutCompletions/{completionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /quizAttempts/{attemptId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /contentProgress/{contentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /dailyRewards/{rewardDay} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /pointsLedger/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /rewards/{rewardId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /settings/{settingsId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && hasOnlySettingsFields();
        allow update: if isOwner(userId) && settingsOnlyMutableFieldsChanged();
      }
    }

    match /leaderboards/{period} {
      allow read: if isSignedIn();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /regions/{regionKey}/entries/{entryId} {
        allow read: if isSignedIn()
          && isValidRegion(regionKey)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.regionKey == regionKey
          && resource.data.regionKey == regionKey
          && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.regionKey == regionKey;
        allow write: if false;
      }
    }

    match /quizLeaderboards/{period} {
      allow read: if isSignedIn();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if false;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /research/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
